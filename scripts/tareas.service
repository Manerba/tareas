[Unit]
Description=Tareas - Aufgabenplanung (FastAPI)
After=network.target

[Service]
Type=simple
User=tareas
Group=tareas
WorkingDirectory=/opt/tareas
ExecStart=/opt/tareas/venv/bin/python dashboard/app.py
Restart=always
RestartSec=5

# Security Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
ReadWritePaths=/opt/tareas/data /var/log
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
